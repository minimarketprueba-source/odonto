# ============================================================
# Control de Peso — variables de entorno (EJEMPLO)
# Copiá este archivo a .env.local y completá con TUS valores.
# NUNCA versionar .env.local ni claves reales en este archivo.
# ============================================================

# --- Supabase (obligatorias para la app) ---
# Proyecto Supabase: Dashboard → Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Solo para scripts de administración (npm run verify-db) ---
# ¡El service role NUNCA va al frontend ni se comparte!
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# --- Observabilidad (opcional) ---
VITE_SENTRY_DSN=

# --- Solo para scripts de verificación con Playwright (opcional) ---
TEST_EMAIL=
TEST_PASSWORD=

# --- Dev server (opcional) ---
# VITE_PORT=5173
# DEV_TUNNEL_HOST=
